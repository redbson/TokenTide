{
  "name": "tokentide",
  "version": "0.6.1",
  "description": "macOS menu-bar and Windows tray widget for Codex, Claude Code, and Qoder quota, weekly utilization, and usage history",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/redbson/TokenTide.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/usage-*.test.mjs tests/quota-*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "build:mac": "node scripts/build-macos.mjs",
    "build:windows": "node scripts/build-windows.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
